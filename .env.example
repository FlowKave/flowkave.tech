# FlowKave SaaS test portal (app.flowkave.tech)
# Copy this file to .env.local and fill values from Supabase Project Settings.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# Optional server-only key for future admin jobs/migrations.
# Never expose this in browser code and never commit .env.local.
# SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY_HERE
